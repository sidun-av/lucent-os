# bootc-image-builder config for the TEST VM image (tools/vm). The release
# ISO uses iso/config.toml, which creates no users.
[[customizations.user]]
name = "lucent"
# test-only password (sudo, lock screen); the VM is only reachable via
# QEMU user networking on 127.0.0.1
password = "lucent"
key = "@SSH_KEY@"
groups = ["wheel"]

[[customizations.filesystem]]
mountpoint = "/"
minsize = "40 GiB"
