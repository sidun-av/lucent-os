[General]
# Explorer habits: status bar with free space, no surprise restore of old tabs.
# A full-width status bar with free space, as in docs/mockups (Dolphin's
# default is a small floating label).
ShowStatusBar=FullWidth
ShowSpaceInfo=true
RememberOpenedTabs=false
ShowFullPath=false
BrowseThroughArchives=true

[MainWindow]
# Windows habit and docs/mockups/01-desktop: menus inside the window.
MenuBar=Enabled
