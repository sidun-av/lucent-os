[General]
# Dolphin treats Version < 200 as a first run and hides the menu bar then,
# overriding MenuBar=Enabled below. 202 = Dolphin 26's config version.
Version=202
# Explorer habits: no surprise restore of old tabs.
RememberOpenedTabs=false
# A plain full-width status bar under the files (docs/mockups/01-desktop)
# instead of the boxed label. Its free-space part would describe the
# read-only system image (Solid maps every local path to "/"), so the Lucent
# widget style hides it when that happens (build_files/lucent-style).
ShowStatusBar=FullWidth
ShowFullPath=false
BrowseThroughArchives=true

[MainWindow]
# Windows habit and docs/mockups/01-desktop: menus inside the window.
MenuBar=Enabled

[IconsMode]
# Large-icon grid like the mockups' folder tiles.
IconSize=64

[PlacesPanel]
# 22 px icons: with the Lucent style's item padding the rows come out at
# the mockup sidebar's ~38 px rhythm.
IconSize=22
