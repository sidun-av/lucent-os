[General]
# Dolphin treats Version < 200 as a first run and hides the menu bar then,
# overriding MenuBar=Enabled below. 202 = Dolphin 26's config version.
Version=202
# Explorer habits: no surprise restore of old tabs. The status bar stays
# Dolphin's small label: the full-width bar always shows free space, and on
# an image-based system Dolphin measures the read-only root ("0 B free").
RememberOpenedTabs=false
ShowFullPath=false
BrowseThroughArchives=true

[MainWindow]
# Windows habit and docs/mockups/01-desktop: menus inside the window.
MenuBar=Enabled

[PlacesPanel]
# 26 px icons: rows close to the mockup sidebar's 38 px rhythm.
IconSize=26
