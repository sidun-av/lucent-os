[org.kde.kdecoration2]
# Lucent window decoration (Aurorae v2, /usr/share/aurorae/themes/Lucent):
# a 48 px header row in the window colour (runs into the app's own menu and
# toolbar), 44 x 36 rounded buttons, Pebble Drift's long soft shadow.
library=org.kde.kwin.aurorae.v2
theme=__aurorae__svg__Lucent
BorderSize=None
BorderSizeAuto=false
# Windows layout: window menu on the left, minimise / maximise / close on the right.
ButtonsOnLeft=M
ButtonsOnRight=IAX

[Windows]
# Double-click on a title bar maximises/restores, exactly like Windows.
TitlebarDoubleClickCommand=Maximize
# Aero Snap: drag to the top edge maximises, to a side edge tiles half-screen.
ElectricBorderMaximize=true
ElectricBorderTiling=true
ElectricBorderCornerRatio=0.25
# Windows does not raise or focus windows just because the mouse passes over them.
FocusPolicy=ClickToFocus
# New windows open centred, as in the mockups (and Windows 11 for most apps).
Placement=Centered

[Plugins]
blurEnabled=true
# KDE-Rounded-Corners: clips every window to Pebble Drift's --radius-window (18 px).
kwin4_effect_shapecornersEnabled=true
scaleEnabled=true
glideEnabled=false
contrastEnabled=true
# The "shake cursor to find it" toy and window wobbling are off for a calm desktop.
shakecursorEnabled=false
wobblywindowsEnabled=false

[Effect-blur]
# Pebble Drift: surfaces are >= 93 % opaque, so the blur behind the taskbar
# and popups is light (--surface-blur: 24 px) and cheap; the noise is the
# design's paper grain on shell surfaces.
BlurStrength=6
NoiseStrength=3

[TabBox]
# Alt+Tab shows large window thumbnails, like Windows 10/11 (Lucent switcher).
LayoutName=org.lucent.switcher

[ModifierOnlyShortcuts]
# Pressing and releasing the Win key alone opens the launcher (Start menu).
Meta=org.kde.plasmashell,/PlasmaShell,org.kde.PlasmaShell,activateLauncherMenu

[Round-Corners]
# Same radius as the decoration (pebble-drift.css --radius-window), a plain
# circular arc, and the 1 px ring of --shadow-window instead of a border.
Size=18
InactiveCornerRadius=18
UseSquircleShape=false
UseNativeDecorationShadows=true
OutlineThickness=1
InactiveOutlineThickness=1
OutlineColor=30,40,100
InactiveOutlineColor=30,40,100
ActiveOutlineAlpha=26
InactiveOutlineAlpha=20
SecondOutlineThickness=0
InactiveSecondOutlineThickness=0

[Wayland]
# No on-screen keyboard: Fedora's kde-settings profile starts plasma-keyboard
# in every session (~200-400 MB, even without a touchscreen) and the login
# screen shows a "Show On-Screen Keyboard" button. The package stays
# (plasma-desktop requires it); it just isn't started.
InputMethod=
VirtualKeyboardEnabled=false
