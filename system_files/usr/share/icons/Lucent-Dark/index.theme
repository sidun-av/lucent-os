[Icon Theme]
Name=Lucent Dark
Comment=Lucent OS icons on top of Papirus-Dark
Inherits=Papirus-Dark,breeze-dark,hicolor
Example=folder
DisplayDepth=32
Directories=scalable/apps,scalable/places

[scalable/apps]
Size=64
MinSize=16
MaxSize=512
Context=Applications
Type=Scalable

[scalable/places]
Size=64
MinSize=32
MaxSize=512
Context=Places
Type=Scalable
