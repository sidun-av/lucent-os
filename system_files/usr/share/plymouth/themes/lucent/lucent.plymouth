[Plymouth Theme]
Name=Lucent
Description=Lucent OS boot splash: the Lucent mark on Drift night (the login screen's colours), with Fedora's spinner
ModuleName=two-step

[two-step]
Font=Inter 12
TitleFont=Inter Light 30
ImageDir=/usr/share/plymouth/themes/lucent
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.382
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.382
HorizontalAlignment=.5
VerticalAlignment=.62
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.45
Transition=none
TransitionDuration=0.0
# Drift night as the login screen shows it (blurred, dimmed), so boot hands
# over to it without a jump: background.png (design/render-boot-background.py,
# 640x360, scaled to the screen once) over a gradient of its top and bottom
# averages, which is also what a Plymouth without background.png shows.
ScaleBackgroundImage=true
BackgroundStartColor=0x211b5a
BackgroundEndColor=0x1a3655
# --surface-raised-2 and --accent of pebble-drift.css, dark
ProgressBarBackgroundColor=0x2c2f44
ProgressBarForegroundColor=0x7088ff
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Installing updates...
SubTitle=Do not turn off your computer

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading Lucent OS...
SubTitle=Do not turn off your computer

[firmware-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Upgrading firmware...
SubTitle=Do not turn off your computer

[system-reset]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Resetting the system...
SubTitle=Do not turn off your computer
