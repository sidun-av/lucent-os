# Lucent Dark: Kvantum theme generated by design/gen_kvantum.py
# from docs/mockups/lucent.css. Do not edit by hand.
[%General]
author=Lucent OS contributors
comment=Lucent Dark: rounded fields, segmented toolbar buttons, soft menus
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
respect_DE=true
dark_titlebar=true
composite=true
translucent_windows=false
blurring=false
popup_blurring=true
menu_blur_radius=10
tooltip_blur_radius=8
menu_shadow_depth=14
tooltip_shadow_depth=8
spread_menuitems=true
menu_separator_height=9
submenu_overlap=0
submenu_delay=200
scrollable_menu=true
combo_menu=true
combo_as_lineedit=true
combo_focus_rect=false
left_tabs=true
center_doc_tabs=false
attach_active_tab=false
joined_inactive_tabs=false
embedded_tabs=false
no_active_tab_separator=true
mirror_doc_tabs=true
group_toolbar_buttons=true
toolbar_item_spacing=2
toolbar_interior_spacing=4
toolbar_separator_thickness=12
center_toolbar_handle=true
slim_toolbars=false
toolbutton_style=0
spread_progressbar=true
progressbar_thickness=6
spread_header=true
menubar_mouse_tracking=true
merge_menubar_with_toolbar=false
transient_scrollbar=true
transient_groove=false
scroll_width=10
scroll_min_extent=40
scroll_arrows=false
scrollbar_in_view=true
tree_branch_line=false
groupbox_top_label=true
slider_width=4
slider_handle_width=20
slider_handle_length=20
check_size=18
vertical_spin_indicators=true
inline_spin_indicators=true
spin_button_width=18
square_combo_button=false
animate_states=true
no_inactiveness=true
no_window_pattern=true
splitter_width=1
layout_spacing=6
layout_margin=10
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_icon_size=20
dialog_button_layout=0
fill_rubberband=false
remove_extra_frames=true
shadowless_popup=false
click_behavior=0
tooltip_delay=-1
opaque=kaffeine,kmplayer,subtitlecomposer,kdenlive,vlc,smplayer,avidemux,kamoso,dragon,haruna,mpv

[GeneralColors]
window.color=#191b21
base.color=#1f2229
alt.base.color=#23262d
button.color=#2b2f38
light.color=#323743
mid.light.color=#323743
dark.color=#0d0f13
mid.color=#2b2f38
shadow.color=#000000
highlight.color=#5b8bff
inactive.highlight.color=#5b8bff
text.color=#eef0f5
window.text.color=#eef0f5
button.text.color=#eef0f5
disabled.text.color=#6c7380
tooltip.base.color=#22252d
tooltip.text.color=#eef0f5
highlight.text.color=#ffffff
link.color=#7ea4ff
link.visited.color=#b08cff
progress.indicator.text.color=#ffffff

[Hacks]
respect_darkness=true
transparent_dolphin_view=false
transparent_ktitle_label=true
transparent_menutitle=true
tint_on_mouseover=0
no_selection_tint=true
normal_default_pushbutton=true
iconless_pushbutton=false
transparent_arrow_button=true
iconless_menu=false
single_top_toolbar=false
style_vertical_toolbars=false
disabled_icon_opacity=45
middle_click_scroll=false
kinetic_scrolling=false
force_size_grip=false

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
frame.expansion=20
interior=true
interior.element=button
indicator.element=arrow
indicator.size=12
text.margin.top=4
text.margin.bottom=4
text.margin.left=10
text.margin.right=10
text.iconspacing=6
text.normal.color=#eef0f5
text.focus.color=#eef0f5
text.press.color=#eef0f5
text.toggle.color=#eef0f5
text.shadow=false
min_width=+1font
min_height=+0.5font

[PanelButtonTool]
inherits=PanelButtonCommand
frame.element=tbutton
interior.element=tbutton
frame.expansion=16
text.margin.left=6
text.margin.right=6
text.normal.color=#eef0f5
text.focus.color=#eef0f5
text.press.color=#eef0f5
text.toggle.color=#eef0f5
min_width=0
min_height=0

[ToolbarButton]
