#!/usr/bin/bash
# Per-user Lucent defaults that Plasma can't take from /etc/xdg.
# Runs once per user (and again when VERSION is bumped), from the Plasma
# session environment hook — i.e. before KWin and its built-in global
# shortcut daemon start, so they read the merged file.
VERSION=1
CONF=${XDG_CONFIG_HOME:-$HOME/.config}
MARK="$CONF/lucent/user-defaults-v$VERSION"
[ -e "$MARK" ] && exit 0

group=
while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
        ''|'#'*) continue ;;
        '['*']') group=${line#[}; group=${group%]} ;;
        *=*)
            key=${line%%=*}; value=${line#*=}
            value=${value//\\t/$'\t'}
            kwriteconfig6 --file kglobalshortcutsrc --group "$group" --key "$key" -- "$value"
            ;;
    esac
done < /usr/share/lucent/kglobalshortcutsrc

mkdir -p "${MARK%/*}" && touch "$MARK"
