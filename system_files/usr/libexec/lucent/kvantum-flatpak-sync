#!/usr/bin/python3 -P
"""Lucent widget style for Flatpak Qt apps.

Native apps get the Lucent Kvantum theme from /usr/share/Kvantum. A Flatpak
app can't see /usr or /etc of the host and reads Kvantum's configuration
from its own config dir (~/.var/app/<id>/config). For every installed app
on a KDE runtime this keeps there:

  Kvantum/kvantum.kvconfig      theme=<active theme>[Dark]: the desktop's
                                Lucent theme for the chosen accent (Lucent,
                                LucentAzure, ... see lucent-theme), in the
                                light or dark variant of the desktop
  Kvantum/<active theme>/       copy of /usr/share/Kvantum/<active theme>

The Kvantum plugin itself comes from Flathub's org.kde.KStyle.Kvantum
extension, installed with QT_STYLE_OVERRIDE=kvantum per app by
/usr/libexec/lucent/flatpak-setup. Runs at login (design-defaults) and when
kdeglobals changes (lucent-kvantum-sync.path, through `lucent-theme sync`).
A kvantum.kvconfig the user wrote (without Lucent's marker line) is left
alone.
"""
import filecmp
import shutil
import subprocess
from pathlib import Path

THEMES = Path("/usr/share/Kvantum")
MARK = "# Managed by Lucent (/usr/libexec/lucent/kvantum-flatpak-sync)"
HOME = Path.home()
CONFIG = HOME / ".config"


def desktop_is_dark() -> bool:
    try:
        style = subprocess.run(["kreadconfig6", "--file", "kdeglobals", "--group", "KDE", "--key", "widgetStyle"],
                               capture_output=True, text=True).stdout.strip().lower()
        scheme = subprocess.run(["kreadconfig6", "--file", "kdeglobals", "--group", "General", "--key", "ColorScheme"],
                                capture_output=True, text=True).stdout.strip().lower()
    except OSError:
        return False
    return style.endswith("-dark") or "dark" in scheme


def active_theme() -> str:
    """The desktop's Kvantum theme folder if it is one of Lucent's, else Lucent."""
    try:
        for line in (CONFIG / "Kvantum/kvantum.kvconfig").read_text(errors="replace").splitlines():
            if line.strip().startswith("theme="):
                name = line.split("=", 1)[1].strip()
                if name.endswith("Dark"):
                    name = name[:-4]
                if name.startswith("Lucent") and (THEMES / name).is_dir():
                    return name
    except OSError:
        pass
    return "Lucent"


def kde_apps() -> list[str]:
    try:
        out = subprocess.run(["flatpak", "list", "--app", "--columns=application,runtime"],
                             capture_output=True, text=True, timeout=30).stdout
    except (OSError, subprocess.TimeoutExpired):
        return []
    apps = []
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) == 2 and parts[1].startswith("org.kde.Platform/"):
            apps.append(parts[0])
    return sorted(set(apps))


def sync_theme(src: Path, dest: Path) -> None:
    dest.mkdir(parents=True, exist_ok=True)
    for f in src.iterdir():
        out = dest / f.name
        if not out.exists() or not filecmp.cmp(f, out, shallow=False):
            shutil.copyfile(f, out)


def main() -> int:
    name = active_theme()
    if not (THEMES / name).is_dir():
        return 0
    variant = name + ("Dark" if desktop_is_dark() else "")
    wanted = f"{MARK}\n[General]\ntheme={variant}\n"
    for app in kde_apps():
        kv = HOME / ".var/app" / app / "config/Kvantum"
        conf = kv / "kvantum.kvconfig"
        if conf.exists() and not conf.read_text(errors="replace").startswith(MARK):
            continue  # the user's own choice
        sync_theme(THEMES / name, kv / name)
        for old in kv.glob("Lucent*"):     # an accent chosen before
            if old.is_dir() and old.name != name:
                shutil.rmtree(old, ignore_errors=True)
        if not conf.exists() or conf.read_text(errors="replace") != wanted:
            conf.write_text(wanted)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:  # never break a login over a cosmetic default
        print(f"lucent kvantum-flatpak-sync: {exc}")
        raise SystemExit(0)
