#!/usr/bin/python3 -P
"""Lucent look: per-user defaults that can't come from /etc/xdg because the
apps keep them in the user's data/state dirs. Run at login (from
/etc/xdg/plasma-workspace/env/lucent-design-defaults.sh). Only seeds what the
user doesn't have yet, so their own choices always win.

- Dolphin and System Settings window sizes and a 278 px places panel
  (docs/mockups/01-desktop),
  and its toolbar: back, forward, up, path, view modes, split, search.
- The places list like the mockup's sidebar: This PC, Desktop, Documents,
  Downloads, Pictures, Music, Videos, Home, Trash; the Remote, Recent, Search
  and Tags groups hidden; and the operating system's own volumes hidden from
  "Devices" (the read-only composefs root and /usr, and the partition that
  holds the OS), so Devices shows the user's disks: "Local Disk (C:)", USB.
  Sidebars made before This PC existed get it added once, at the top.
- How Files shows This PC (thispc:/, docs/this-pc.md): grouped into
  Folders / Drives and devices / Recent files, large icons with one grey
  detail line ("212 items", "410 GB free of 512 GB"). Dolphin keeps one set
  of view properties for all non-local locations, so this is where it goes.
- Flatpak Qt apps get the Lucent Kvantum theme (kvantum-flatpak-sync).
- A picture for the account if it has none: the user's initial on the
  launcher's peach-pink gradient, set through AccountsService so the login
  and lock screens, the launcher and Settings all show it.
"""
import os
import re
import shutil
import subprocess
import time
from pathlib import Path
from xml.sax.saxutils import escape

HOME = Path.home()
STATE = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state")
DATA = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local/share")

# (path or URL, title, icon); titles are translated by KIO, except This PC's
# (Lucent's own catalog, see this_pc_title). Icons: the mockup sidebar's
# accent line glyphs (Lucent icon theme, lucent-place-*).
THIS_PC = ("thispc:/", "This PC", "lucent-place-pc")
PLACES = [
    THIS_PC,
    ("Desktop", "Desktop", "lucent-place-desktop"),
    ("Documents", "Documents", "lucent-place-documents"),
    ("Downloads", "Downloads", "lucent-place-downloads"),
    ("Pictures", "Pictures", "lucent-place-pictures"),
    ("Music", "Music", "lucent-place-music"),
    ("Videos", "Videos", "lucent-place-videos"),
    ("", "Home", "lucent-place-home"),
    ("trash:/", "Trash", "lucent-place-trash"),
    ("remote:/", "Network", "lucent-place-network"),
    ("recentlyused:/files", "Recent Files", "lucent-place-recent"),
    ("recentlyused:/locations", "Recent Locations", "lucent-place-recent"),
]
HIDDEN_GROUPS = {"Places": False, "Remote": True, "Devices": False, "RemovableDevices": False,
                 "Tags": True, "RecentlySaved": True, "SearchFor": True}
ALWAYS_HIDDEN_UDIS = ["/org/kde/fstab/overlay/", "/org/kde/fstab/overlay/usr"]


def udisks_udi(dev: str) -> str:
    """/dev/dm-0 -> /org/freedesktop/UDisks2/block_devices/dm_2d0"""
    name = Path(dev).name
    return "/org/freedesktop/UDisks2/block_devices/" + re.sub(
        r"[^A-Za-z0-9]", lambda m: "_%02x" % ord(m.group()), name)


def system_volume_udis() -> list[str]:
    """The block device(s) holding the OS: /sysroot's source and, for an
    encrypted install, its LUKS container."""
    try:
        src = subprocess.run(["findmnt", "-no", "SOURCE", "/sysroot"], capture_output=True,
                             text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return []
    src = os.path.realpath(src.split("[")[0])
    if not src.startswith("/dev/"):
        return []
    udis = [udisks_udi(src)]
    try:
        parent = subprocess.run(["lsblk", "-no", "PKNAME", src], capture_output=True,
                                text=True, check=True).stdout.split()
        if parent and Path(src).name.startswith("dm-"):
            udis.append(udisks_udi("/dev/" + parent[0]))
    except (OSError, subprocess.CalledProcessError):
        pass
    return udis


def places_xbel() -> str:
    stamp = int(time.time())
    meta = "".join(f"   <GroupState-{g}-IsHidden>{str(h).lower()}</GroupState-{g}-IsHidden>\n"
                   for g, h in HIDDEN_GROUPS.items())
    out = ['<?xml version="1.0" encoding="UTF-8"?>\n<!DOCTYPE xbel>\n'
           '<xbel xmlns:bookmark="http://www.freedesktop.org/standards/desktop-bookmarks" '
           'xmlns:kdepriv="http://www.kde.org/kdepriv" '
           'xmlns:mime="http://www.freedesktop.org/standards/shared-mime-info">\n'
           ' <info>\n  <metadata owner="http://www.kde.org">\n'
           '   <kde_places_version>4</kde_places_version>\n' + meta +
           '   <withRecentlyUsed>true</withRecentlyUsed>\n   <withBaloo>true</withBaloo>\n'
           '  </metadata>\n </info>\n']
    for i, (target, title, icon) in enumerate(PLACES):
        href = target if ":/" in target else (HOME / target).as_uri() if target else HOME.as_uri()
        if (target, title, icon) == THIS_PC:
            if not this_pc_available():
                continue
            title = this_pc_title()
        out.append(bookmark(href, title, icon, f"{stamp}/{i}"))
    for udi in ALWAYS_HIDDEN_UDIS + system_volume_udis():
        out.append(f' <separator>\n  <info>\n   <metadata owner="http://www.kde.org">\n'
                   f'    <UDI>{escape(udi)}</UDI>\n    <isSystemItem>true</isSystemItem>\n'
                   f'    <IsHidden>true</IsHidden>\n   </metadata>\n  </info>\n </separator>\n')
    out.append('</xbel>\n')
    return "".join(out)


def bookmark(href: str, title: str, icon: str, ident: str) -> str:
    return (f' <bookmark href="{escape(href)}">\n  <title>{escape(title)}</title>\n'
            f'  <info>\n   <metadata owner="http://freedesktop.org">\n'
            f'    <bookmark:icon name="{icon}"/>\n   </metadata>\n'
            f'   <metadata owner="http://www.kde.org">\n    <ID>{ident}</ID>\n'
            f'    <isSystemItem>true</isSystemItem>\n   </metadata>\n  </info>\n </bookmark>\n')


def this_pc_available() -> bool:
    """kio_thispc is in the image (build_files/thispc.sh leaves it out, and
    Files opens on Home, if it ever fails to build)."""
    return any(Path("/usr").glob("lib*/qt6/plugins/kf6/kio/thispc.so"))


def _thispc_catalog():
    import gettext
    return gettext.translation("lucent-thispc", fallback=True)


def this_pc_title() -> str:
    """"This PC" in the user's language (the worker's catalog, po/ru.po)."""
    return _thispc_catalog().pgettext("@title the overview page of Files", "This PC")


def add_this_pc(xbel: str, title: str) -> str:
    """Put This PC at the top of a sidebar that doesn't have it yet."""
    if f'href="{THIS_PC[0]}"' in xbel:
        return xbel
    entry = bookmark(THIS_PC[0], title, THIS_PC[2], f"{int(time.time())}/thispc")
    info = re.search(r"<xbel[^>]*>\s*<info>.*?</info>\n?", xbel, re.S)
    head = info or re.search(r"<xbel[^>]*>\n?", xbel)
    if not head:
        return xbel
    return xbel[:head.end()] + entry + xbel[head.end():]


# thispc:/ as the page is meant to look. Dolphin keeps one set of view
# properties for every non-local location (remote/), used only when "one
# view style for all folders" is off (/etc/xdg/dolphinrc GlobalViewProps).
# Grouped by "Type" (the section), the grey line is "Owner" (the detail);
# both are what kio_thispc puts there. No previews: they'd cover the ring
# icons of the drives.
THISPC_VIEW = """[Dolphin]
GroupedSorting=true
GroupRole=type
PreviewsShown=false
SortFoldersFirst=true
SortRole=text
Version=4
ViewMode=0
VisibleRoles=Icons_text,Icons_owner,Compact_text,Compact_owner,Details_text,Details_owner,Details_modificationtime
"""


def seed_thispc_view(data: Path) -> None:
    props = data / "dolphin/view_properties/remote/.directory"
    if props.exists():
        return
    props.parent.mkdir(parents=True, exist_ok=True)
    t = time.localtime()
    stamp = ",".join(str(n) for n in (t.tm_year, t.tm_mon, t.tm_mday, t.tm_hour, t.tm_min, t.tm_sec))
    props.write_text(THISPC_VIEW + f"Timestamp={stamp}\n")


def account_picture() -> None:
    uid = os.getuid()
    path = f"/org/freedesktop/Accounts/User{uid}"
    def prop(name):
        out = subprocess.run(["busctl", "--system", "get-property", "org.freedesktop.Accounts", path,
                              "org.freedesktop.Accounts.User", name], capture_output=True, text=True).stdout
        return out.strip()[3:-1] if out.startswith('s "') else ""
    icon = prop("IconFile")
    if icon and Path(icon).is_file():
        return  # the user (or the installer) already chose one
    name = prop("RealName") or prop("UserName") or os.environ.get("USER", "?")
    os.environ["QT_QPA_PLATFORM"] = "offscreen"
    from PySide6.QtCore import QPointF, QRectF, Qt
    from PySide6.QtGui import QColor, QFont, QGuiApplication, QImage, QLinearGradient, QPainter
    app = QGuiApplication.instance() or QGuiApplication([])
    img = QImage(256, 256, QImage.Format.Format_ARGB32)
    grad = QLinearGradient(QPointF(0, 0), QPointF(256, 256))
    grad.setColorAt(0, QColor("#ffb37a"))
    grad.setColorAt(1, QColor("#f2668b"))
    p = QPainter(img)
    p.fillRect(img.rect(), grad)
    p.setPen(QColor("white"))
    font = QFont("Inter")
    font.setPixelSize(118)
    font.setWeight(QFont.Weight.Bold)
    p.setFont(font)
    p.drawText(QRectF(0, 0, 256, 256), Qt.AlignmentFlag.AlignCenter, name[:1].upper())
    p.end()
    out = DATA / "lucent/account-picture.png"
    out.parent.mkdir(parents=True, exist_ok=True)
    img.save(str(out))
    del app
    subprocess.run(["busctl", "--system", "call", "org.freedesktop.Accounts", path,
                    "org.freedesktop.Accounts.User", "SetIconFile", "s", str(out)], capture_output=True)


def main() -> int:
    STATE.mkdir(parents=True, exist_ok=True)
    if not (STATE / "dolphinstaterc").exists():
        shutil.copy("/usr/share/lucent/design/dolphinstaterc", STATE / "dolphinstaterc")
    # System Settings opens at the same mockup proportions as Files
    # (03-settings is a large window), not KDE's small default.
    settings = STATE / "systemsettingsstaterc"
    if not settings.exists():
        sizes = [l for l in Path("/usr/share/lucent/design/dolphinstaterc").read_text().splitlines()
                 if " screen: " in l]
        settings.write_text("[MainWindow]\n" + "\n".join(sizes) + "\n")
    toolbar = DATA / "kxmlgui5/dolphin/dolphinui.rc"
    if not toolbar.exists():
        toolbar.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy("/usr/share/lucent/design/dolphinui.rc", toolbar)
    places = DATA / "user-places.xbel"
    thispc_marker = DATA / "lucent/thispc-place-v1"
    if not places.exists():
        places.parent.mkdir(parents=True, exist_ok=True)
        places.write_text(places_xbel(), encoding="utf-8")
    elif not thispc_marker.exists() and this_pc_available():
        # once: a user who later removes This PC from the sidebar keeps it removed
        places.write_text(add_this_pc(places.read_text(encoding="utf-8"), this_pc_title()), encoding="utf-8")
    if this_pc_available():
        thispc_marker.parent.mkdir(parents=True, exist_ok=True)
        thispc_marker.touch()
        seed_thispc_view(DATA)
    marker = DATA / "lucent/account-picture.png"
    if not marker.exists():
        account_picture()
    # Flatpak Qt apps: Lucent's Kvantum theme in their config dirs.
    subprocess.run(["/usr/libexec/lucent/kvantum-flatpak-sync"], timeout=60)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:  # never block the login over a cosmetic default
        print(f"lucent design-defaults: {exc}")
        raise SystemExit(0)
