#!/usr/bin/python3 -P
"""Lucent look: per-user defaults that can't come from /etc/xdg because the
apps keep them in the user's data/state dirs. Run at login (from
/etc/xdg/plasma-workspace/env/lucent-design-defaults.sh). Only seeds what the
user doesn't have yet, so their own choices always win.

- Dolphin window size and a 278 px places panel (docs/mockups/01-desktop),
  and its toolbar: back, forward, up, path, view modes, split, search.
- The places list like the mockup's sidebar: Desktop, Documents, Downloads,
  Pictures, Music, Videos, Home, Trash; the Remote, Recent, Search and Tags
  groups hidden; and the operating system's own volumes hidden from
  "Devices" (the read-only composefs root and /usr, and the partition that
  holds the OS), so Devices shows the user's disks: "Windows (C:)", USB.
"""
import os
import re
import shutil
import subprocess
import time
from pathlib import Path
from xml.sax.saxutils import escape

HOME = Path.home()
STATE = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state")
DATA = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local/share")

PLACES = [  # (path or URL, title, icon); titles are translated by KIO
    ("Desktop", "Desktop", "user-desktop"),
    ("Documents", "Documents", "folder-documents"),
    ("Downloads", "Downloads", "folder-downloads"),
    ("Pictures", "Pictures", "folder-pictures"),
    ("Music", "Music", "folder-music"),
    ("Videos", "Videos", "folder-videos"),
    ("", "Home", "user-home"),
    ("trash:/", "Trash", "user-trash"),
    ("remote:/", "Network", "folder-network"),
    ("recentlyused:/files", "Recent Files", "document-open-recent"),
    ("recentlyused:/locations", "Recent Locations", "folder-open-recent"),
]
HIDDEN_GROUPS = {"Places": False, "Remote": True, "Devices": False, "RemovableDevices": False,
                 "Tags": True, "RecentlySaved": True, "SearchFor": True}
ALWAYS_HIDDEN_UDIS = ["/org/kde/fstab/overlay/", "/org/kde/fstab/overlay/usr"]


def udisks_udi(dev: str) -> str:
    """/dev/dm-0 -> /org/freedesktop/UDisks2/block_devices/dm_2d0"""
    name = Path(dev).name
    return "/org/freedesktop/UDisks2/block_devices/" + re.sub(
        r"[^A-Za-z0-9]", lambda m: "_%02x" % ord(m.group()), name)


def system_volume_udis() -> list[str]:
    """The block device(s) holding the OS: /sysroot's source and, for an
    encrypted install, its LUKS container."""
    try:
        src = subprocess.run(["findmnt", "-no", "SOURCE", "/sysroot"], capture_output=True,
                             text=True, check=True).stdout.strip()
    except (OSError, subprocess.CalledProcessError):
        return []
    src = os.path.realpath(src.split("[")[0])
    if not src.startswith("/dev/"):
        return []
    udis = [udisks_udi(src)]
    try:
        parent = subprocess.run(["lsblk", "-no", "PKNAME", src], capture_output=True,
                                text=True, check=True).stdout.split()
        if parent and Path(src).name.startswith("dm-"):
            udis.append(udisks_udi("/dev/" + parent[0]))
    except (OSError, subprocess.CalledProcessError):
        pass
    return udis


def places_xbel() -> str:
    stamp = int(time.time())
    meta = "".join(f"   <GroupState-{g}-IsHidden>{str(h).lower()}</GroupState-{g}-IsHidden>\n"
                   for g, h in HIDDEN_GROUPS.items())
    out = ['<?xml version="1.0" encoding="UTF-8"?>\n<!DOCTYPE xbel>\n'
           '<xbel xmlns:bookmark="http://www.freedesktop.org/standards/desktop-bookmarks" '
           'xmlns:kdepriv="http://www.kde.org/kdepriv" '
           'xmlns:mime="http://www.freedesktop.org/standards/shared-mime-info">\n'
           ' <info>\n  <metadata owner="http://www.kde.org">\n'
           '   <kde_places_version>4</kde_places_version>\n' + meta +
           '   <withRecentlyUsed>true</withRecentlyUsed>\n   <withBaloo>true</withBaloo>\n'
           '  </metadata>\n </info>\n']
    for i, (target, title, icon) in enumerate(PLACES):
        href = target if ":/" in target else (HOME / target).as_uri() if target else HOME.as_uri()
        out.append(f' <bookmark href="{escape(href)}">\n  <title>{escape(title)}</title>\n'
                   f'  <info>\n   <metadata owner="http://freedesktop.org">\n'
                   f'    <bookmark:icon name="{icon}"/>\n   </metadata>\n'
                   f'   <metadata owner="http://www.kde.org">\n    <ID>{stamp}/{i}</ID>\n'
                   f'    <isSystemItem>true</isSystemItem>\n   </metadata>\n  </info>\n </bookmark>\n')
    for udi in ALWAYS_HIDDEN_UDIS + system_volume_udis():
        out.append(f' <separator>\n  <info>\n   <metadata owner="http://www.kde.org">\n'
                   f'    <UDI>{escape(udi)}</UDI>\n    <isSystemItem>true</isSystemItem>\n'
                   f'    <IsHidden>true</IsHidden>\n   </metadata>\n  </info>\n </separator>\n')
    out.append('</xbel>\n')
    return "".join(out)


def main() -> int:
    STATE.mkdir(parents=True, exist_ok=True)
    if not (STATE / "dolphinstaterc").exists():
        shutil.copy("/usr/share/lucent/design/dolphinstaterc", STATE / "dolphinstaterc")
    toolbar = DATA / "kxmlgui5/dolphin/dolphinui.rc"
    if not toolbar.exists():
        toolbar.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy("/usr/share/lucent/design/dolphinui.rc", toolbar)
    places = DATA / "user-places.xbel"
    if not places.exists():
        places.parent.mkdir(parents=True, exist_ok=True)
        places.write_text(places_xbel(), encoding="utf-8")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:  # never block the login over a cosmetic default
        print(f"lucent design-defaults: {exc}")
        raise SystemExit(0)
