#!/usr/bin/bash
# Lucent's default apps (system-wide Flatpaks from Flathub).
#
# Installed from the installer ISO, apps are already present before the
# first login (iso/lucent-apps.ks unpacks the offline bundle into
# /var/lib/flatpak). This unit then only sets the remote up (no network) and
# finds nothing missing. On the online path (`bootc switch`, a disk image
# without the bundle, or a damaged bundle) it downloads what is missing,
# retried by systemd until it succeeds.
set -euo pipefail

# v2: adds the Kvantum style extension (runs once more on v1 systems).
DONE=/var/lib/lucent/flatpaks-v2.done
LIST=/usr/share/lucent/flatpaks.list

has_remote() { flatpak remotes --system --columns=name | grep -qx "$1"; }

# `remote-add` fetches the .flatpakrepo file, so only when it isn't set up yet.
if ! has_remote flathub; then
    flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
fi
# Fedora ships Flathub filtered/disabled; Lucent uses the full, upstream-built Flathub.
flatpak remote-modify --system --enable --no-filter flathub
# One source of truth: avoid duplicate Okular/Firefox entries from Fedora's
# own Flatpak remote showing up next to the Flathub ones in Discover.
if has_remote fedora; then
    flatpak remote-modify --system --disable fedora
fi

mapfile -t APPS < <(grep -Ev '^\s*(#|$)' "$LIST")
missing=()
for app in "${APPS[@]}"; do
    flatpak info --system "$app" &>/dev/null || missing+=("$app")
done
if ((${#missing[@]})); then
    echo "installing from Flathub: ${missing[*]}"
    flatpak install --system --noninteractive flathub "${missing[@]}"
else
    echo "all ${#APPS[@]} default apps are installed"
fi

# Lucent's widget style for Flatpak Qt apps: Flathub's Kvantum extension
# (org.kde.KStyle.Kvantum, GPL-3.0) for each KDE runtime branch an app uses,
# and QT_STYLE_OVERRIDE=kvantum for those apps. The theme itself is put into
# each app's config dir per user (/usr/libexec/lucent/kvantum-flatpak-sync).
# Apps on a runtime Flathub has no Kvantum build for keep Breeze.
if ! available=$(flatpak remote-ls --system flathub --runtime --columns=application,branch 2>/dev/null \
                 | awk '$1 == "org.kde.KStyle.Kvantum" {print $2}'); then
    echo "Flathub unreachable; retrying later for the Kvantum style extension" >&2
    exit 1
fi
while IFS=$'\t' read -r app runtime; do
    [[ "$runtime" == org.kde.Platform/* ]] || continue
    branch=${runtime##*/}
    grep -qxF "$branch" <<< "$available" || { echo "no Kvantum build for KDE runtime $branch ($app)"; continue; }
    flatpak info --system "org.kde.KStyle.Kvantum//$branch" &>/dev/null \
        || flatpak install --system --noninteractive flathub "org.kde.KStyle.Kvantum//$branch"
    flatpak override --system --env=QT_STYLE_OVERRIDE=kvantum "$app"
done < <(flatpak list --system --app --columns=application,runtime)

mkdir -p "$(dirname "$DONE")"
touch "$DONE"
