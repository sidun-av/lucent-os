[Unit]
Description=Lucent: keep the chosen accent and Flatpak Qt apps in step with the desktop's look

[Service]
Type=oneshot
# Puts the accent chosen with lucent-theme back after Plasma switched the
# global theme (automatic light/dark), points Kvantum at the matching theme
# and syncs it into Flatpak Qt apps (kvantum-flatpak-sync).
ExecStart=/usr/bin/lucent-theme sync
Nice=10
