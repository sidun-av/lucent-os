[Unit]
Description=Lucent OS: housekeeping Fedora runs at boot (man-page and AppStream caches, third-party repositories), after the login
Documentation=https://github.com/sidun-av/lucent-os/blob/main/docs/performance.md
# Started by lucent-after-boot.timer instead of multi-user.target
# (build_files/performance.sh): the same oneshots (the two cache rebuilds
# at their own idle priority, Nice=19 and IOWeight=10), out of the way of the
# boot and the login.
Wants=fedora-atomic-desktop-mandb-update.service fedora-atomic-desktop-appstream-cache-refresh.service
Wants=fedora-third-party-refresh.service
