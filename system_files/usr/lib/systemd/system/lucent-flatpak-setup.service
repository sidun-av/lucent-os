[Unit]
Description=Lucent OS: install default Flathub apps
Documentation=https://github.com/sidun-av/lucent-os
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/lib/lucent/flatpaks-v1.done
# keep retrying (offline first boot, flaky Wi-Fi) instead of giving up
StartLimitIntervalSec=0

[Service]
# Not oneshot: a oneshot unit stays "activating" until every app is
# downloaded, which holds multi-user.target/graphical.target for minutes on
# first boot (measured: 2 min in a VM). The install runs in the background.
Type=exec
ExecStart=/usr/libexec/lucent/flatpak-setup
Restart=on-failure
RestartSec=120
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
