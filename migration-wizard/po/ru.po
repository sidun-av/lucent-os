msgid "Bookmarks Menu"
msgstr "Меню закладок"

msgid "Bookmarks Toolbar"
msgstr "Панель закладок"

msgid "Other Bookmarks"
msgstr "Другие закладки"

msgid "Mobile Bookmarks"
msgstr "Мобильные закладки"

msgid "Bookmarks — {browser} ({profile}).html"
msgstr "Закладки — {browser} ({profile}).html"

