# Russian translation of Lucent OS's own UI (migration wizard, drive names).
# English is the source language. Compiled at image build time by
# `python3 -m lucent_migrate.i18n po /usr/share/locale`.
msgid ""
msgstr ""
"Project-Id-Version: lucent\n"
"Language: ru\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

msgid "Move from Windows"
msgstr "Переезд с Windows"

msgid "This assistant copies your documents, photos, music and browser bookmarks from a Windows disk. The Windows disk is opened <b>read-only</b>: nothing on it will change."
msgstr "Этот помощник перенесёт ваши документы, фотографии, музыку и закладки браузера с диска Windows. Диск Windows открывается <b>только для чтения</b> — на нём ничего не изменится."

msgid "Don't show this again at login"
msgstr "Больше не показывать при входе"

msgid "Windows disks found: <b>{n}</b>."
msgstr "Найдено дисков Windows: <b>{n}</b>."

msgid "Some disks are encrypted with <b>BitLocker</b>. Open them in Files (Dolphin) and enter the BitLocker recovery key (you can find it at account.microsoft.com/devices/recoverykey), then run this assistant again."
msgstr "Некоторые диски зашифрованы <b>BitLocker</b>. Откройте их в «Файлах» (Dolphin) и введите ключ восстановления BitLocker (его можно найти на account.microsoft.com/devices/recoverykey), затем запустите помощник снова."

msgid "No readable Windows disks found. Connect the disk and run this assistant again."
msgstr "Читаемых дисков Windows не найдено. Подключите диск и запустите помощник ещё раз."

msgid "Whose files should be copied?"
msgstr "Чьи файлы перенести?"

msgid "No user folders were found on the Windows disks."
msgstr "На дисках Windows не найдено папок пользователей."

msgid "Could not open: {errors}"
msgstr "Не удалось открыть: {errors}"

msgid "You need an administrator's permission to open this disk."
msgstr "Чтобы открыть этот диск, нужно разрешение администратора."

msgid "Windows is hibernated or uses Fast Startup, so its disk can't be opened. Start Windows, hold Shift while you click Shut down, then try again."
msgstr "Windows находится в режиме гибернации или использует быстрый запуск, поэтому её диск нельзя открыть. Запустите Windows, удерживайте Shift и нажмите «Завершение работы», затем попробуйте снова."

msgid "What to copy"
msgstr "Что перенести"

msgid "Folder"
msgstr "Папка"

msgid "Size"
msgstr "Размер"

msgid "Copy to"
msgstr "Куда"

msgid "If a file with the same name already exists:"
msgstr "Если файл с таким именем уже есть:"

msgid "Keep both (file (2).docx)"
msgstr "Сохранить оба (файл (2).docx)"

msgid "Replace if the Windows file is newer"
msgstr "Заменить, если файл из Windows новее"

msgid "Skip"
msgstr "Пропустить"

msgid "Desktop"
msgstr "Рабочий стол"

msgid "Documents"
msgstr "Документы"

msgid "Downloads"
msgstr "Загрузки"

msgid "Music"
msgstr "Музыка"

msgid "Pictures"
msgstr "Изображения"

msgid "Videos"
msgstr "Видео"

msgid "Browsers and Wi-Fi"
msgstr "Браузеры и Wi-Fi"

msgid "Browser bookmarks"
msgstr "Закладки браузеров"

msgid "Wi-Fi networks"
msgstr "Сети Wi-Fi"

msgid "Windows keeps Wi-Fi passwords encrypted (DPAPI) and tied to that Windows installation, so they cannot be decrypted from here. Only the <b>network names</b> are copied; you will be asked for each password once, on first connect."
msgstr "Windows хранит пароли Wi-Fi в зашифрованном виде (DPAPI), привязанном к самой Windows, — расшифровать их отсюда невозможно. Поэтому переносятся только <b>названия сетей</b>; пароль спросят один раз при первом подключении."

msgid "{browser} ({profile}): could not read: {error}"
msgstr "{browser} ({profile}) — ошибка чтения: {error}"

msgid "{browser} ({profile}): {n} bookmarks"
msgstr "{browser} ({profile}) — закладок: {n}"

msgid "enterprise network, set it up manually"
msgstr "корпоративная сеть, настройте вручную"

msgid "Copying…"
msgstr "Переносим…"

msgid "Bookmarks from Windows"
msgstr "Закладки из Windows"

msgid "Bookmarks were saved to “{folder}”. In Firefox: Bookmarks → Manage Bookmarks → Import and Backup → Import Bookmarks from HTML."
msgstr "Закладки сохранены в «{folder}». В Firefox: Закладки → Управление закладками → Импорт и резервные копии → Импорт закладок из HTML-файла."

msgid "Wi-Fi networks added: {added} of {total}."
msgstr "Добавлено сетей Wi-Fi: {added} из {total}."

msgid "Done"
msgstr "Готово"

msgid "Files copied: <b>{copied}</b>, skipped: {skipped}."
msgstr "Скопировано файлов: <b>{copied}</b>, пропущено: {skipped}."

msgid "Copying was stopped. Files that were already copied stay where they are."
msgstr "Перенос остановлен. Уже скопированные файлы остались на месте."

msgid "Could not copy: {n} (see the list below)."
msgstr "Не удалось скопировать: {n} (список ниже)."

msgid "Next"
msgstr "Далее"

msgid "Back"
msgstr "Назад"

