<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Lucent OS</vendor>
  <action id="org.lucent.settings.auto-updates">
    <description>Turn automatic system updates on or off</description>
    <description xml:lang="ru">Включить или выключить автоматические обновления системы</description>
    <message>Authentication is required to change how the system updates</message>
    <message xml:lang="ru">Чтобы изменить способ обновления системы, нужна аутентификация</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/lucent/settings-helper</annotate>
  </action>
</policyconfig>
