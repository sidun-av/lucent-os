# Russian translation of the Lucent launch sheet (apps/lucent-bridge-sheet).
# English is the source language. Error explanations come translated from
# lucent-bridge itself.
msgid ""
msgstr ""
"Project-Id-Version: lucent-bridge-sheet\n"
"Language: ru\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

