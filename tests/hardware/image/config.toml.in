# bootc-image-builder config for the TEST image of the hardware-live test
# (tests/hardware/image). The release ISO uses iso/config.toml, no users.
[[customizations.user]]
name = "lucent"
password = "lucent"
key = "@SSH_KEY@"
groups = ["wheel"]

[[customizations.filesystem]]
mountpoint = "/"
minsize = "30 GiB"
