#!/usr/bin/bash
# TEST IMAGE ONLY: give the control NIC (QEMU user network with restrict=on,
# so no internet through it; SSH forwarded from the runner) the address
# QEMU forwards to.
for _ in $(seq 90); do
    for i in /sys/class/net/*; do
        [ "$(cat "$i/address" 2>/dev/null)" = 52:54:00:4c:00:01 ] && dev=${i##*/}
    done
    [ -n "${dev:-}" ] && break
    sleep 1
done
[ -n "${dev:-}" ] || { echo "no control NIC"; exit 0; }
ip link set "$dev" up
ip addr replace 10.0.2.15/24 dev "$dev"
echo "control link $dev: 10.0.2.15/24"
